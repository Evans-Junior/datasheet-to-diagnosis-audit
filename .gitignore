# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.python-version

# ---------------------------------------------------------------------------
# Data: raw sources and model weights are never committed.
# Reproduce them with scripts/fetch_*.py — see README.md.
# ---------------------------------------------------------------------------
data/raw/
data/cache/
*.safetensors
*.gguf
*.bin
*.pt
*.npz
*.arrow

# Cached API responses (infini-gram etc.) are large and regenerable.
# The cache *manifest* is committed so counts stay reproducible.
data/cache/**
!data/cache/manifest.json

# PhysioNet / Q-Pain source files: redistribution is governed by their
# licence. Fetch them yourself with credentials; do not commit.
data/raw/qpain/
data/raw/physionet/

# ---------------------------------------------------------------------------
# Results: figures and tables are regenerable from src/.
# Committed deliberately per-file when they appear in the write-up.
# ---------------------------------------------------------------------------
results/**/*.png
results/**/*.pdf
results/**/*.svg
results/raw/
*.parquet

# ---------------------------------------------------------------------------
# Local scratch and tooling (not part of the research record)
# ---------------------------------------------------------------------------
scratch/
tmp/
*.log
.DS_Store
.vscode/
.idea/
.env
.env.local

# Assistant and editor working files. AI_USE.md is tracked on purpose:
# it is the project's disclosure of tool use and belongs in the record.
.claude/
CLAUDE.md
claude_code_research_prompt.md
*.local.md

# Source guideline PDFs. Read locally, quoted with attribution in
# docs/vignette_sources.md, never redistributed: GINA's report is stamped
# "COPYRIGHTED MATERIAL - DO NOT COPY OR DISTRIBUTE", and the IDSA, JAMA, NICE,
# AHA/ACC and CUA documents are copyrighted too. The verbatim blocks plus a DOI
# are what the repo carries; they are reproducible from the citations.
papers/

# ---------------------------------------------------------------------------
# Deck build (deck_src/) and Office scratch files
# ---------------------------------------------------------------------------
# The deck is generated from deck_src/*.js; its dependency tree is not.
node_modules/
package-lock.json

# Microsoft Office writes a ~$<name> lock file beside any open document.
# These are per-session junk and must never be committed.
~$*
.~lock.*#

# ---------------------------------------------------------------------------
# Before/after snapshots of results/tables, taken by hand before a rescore so
# the effect of a change can be diffed. Working artefacts, not the research
# record: every comparison that mattered is written up in docs/decisions.md
# (which vignettes moved, by how much, and what flipped). Regenerable by
# checking out an earlier commit and re-running scripts/run_full_pipeline.sh.
# Kept locally, never pushed — 194 files of superseded tables is clutter in a
# repository someone has to read.
# ---------------------------------------------------------------------------
results/_backup_*/
