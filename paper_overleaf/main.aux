\@writefile{toc}{\contentsline {paragraph}{A model with no gap may be blind rather than fair.}{10}{section*.13}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{A floor is not optional either, and ours was not enough.}{10}{section*.14}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The harm falls on the patients the data never shows.}{10}{section*.15}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Instruction tuning is not a safety guarantee.}{10}{section*.16}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Open data is necessary but not sufficient.}{10}{section*.17}\protected@file@percent }
